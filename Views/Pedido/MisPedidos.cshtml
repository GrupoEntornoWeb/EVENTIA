@model EVENTIA.ViewModels.MisPedidosViewModel
@{ ViewData["Title"] = "Mis Pedidos"; }

<h2>Mis Pedidos</h2>

@{
    var esProveedor = Model.TipoPerfil == "Proveedor";
    var colOtro = esProveedor ? "Cliente" : "Proveedor";
}

<form asp-action="MisPedidos" method="get" class="card p-3 mb-4 shadow-sm">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-select">
                <option value="">Todos</option>
                <option value="Reservado" selected="@(Model.FiltroEstado == "Reservado")">Reservado</option>
                <option value="Confirmado" selected="@(Model.FiltroEstado == "Confirmado")">Confirmado</option>
                <option value="Entregado" selected="@(Model.FiltroEstado == "Entregado")">Entregado</option>
                <option value="Devuelto" selected="@(Model.FiltroEstado == "Devuelto")">Devuelto</option>
                <option value="Cancelado" selected="@(Model.FiltroEstado == "Cancelado")">Cancelado</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Fecha evento</label>
            <input type="date" name="fecha" value="@(Model.FiltroFecha?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-dark me-2">Filtrar</button>
            <a asp-action="MisPedidos" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </div>
</form>

@if (!Model.Pedidos.Any())
{
    <div class="alert alert-info">No tienes pedidos con los filtros seleccionados.</div>
}
else
{
    <p class="text-muted mb-2">
        Mostrando @(Model.PedidosPagina.Any() ? ((Model.PaginaActual - 1) * Model.TamanoPagina + 1) : 0)
        - @(Math.Min(Model.PaginaActual * Model.TamanoPagina, Model.TotalRegistros))
        de @Model.TotalRegistros registros
    </p>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>@colOtro</th>
                    <th>Fecha Evento</th>
                    <th>Monto</th>
                    <th>Estado</th>
                    <th>Pago</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.PedidosPagina)
                {
                    <tr>
                        <td>@p.PedidoId</td>
                        <td>@(esProveedor ? p.Cliente.ClienteNavigation.Nombre : p.Proveedor.NombreNegocio)</td>
                        <td>@p.FechaEvento.ToString("dd/MM/yyyy")</td>
                        <td>S/ @p.MontoTotal.ToString("F2")</td>
                        <td><span class="badge @GetEstadoBadgeClass(p.Estado)">@p.Estado</span></td>
                        <td>@(p.Pago != null ? "Pagado" : "Pendiente")</td>
                        <td>
                            <a asp-action="Detalle" asp-route-id="@p.PedidoId" class="btn btn-sm btn-outline-dark">Ver</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="MisPedidos"
                       asp-route-pagina="@(Model.PaginaActual - 1)"
                       asp-route-estado="@Model.FiltroEstado"
                       asp-route-fecha="@(Model.FiltroFecha?.ToString("yyyy-MM-dd"))">Anterior</a>
                </li>

                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" asp-action="MisPedidos"
                           asp-route-pagina="@i"
                           asp-route-estado="@Model.FiltroEstado"
                           asp-route-fecha="@(Model.FiltroFecha?.ToString("yyyy-MM-dd"))">@i</a>
                    </li>
                }

                <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="MisPedidos"
                       asp-route-pagina="@(Model.PaginaActual + 1)"
                       asp-route-estado="@Model.FiltroEstado"
                       asp-route-fecha="@(Model.FiltroFecha?.ToString("yyyy-MM-dd"))">Siguiente</a>
                </li>
            </ul>
        </nav>
    }
}

@functions {
    string GetEstadoBadgeClass(string estado) => estado switch
    {
        "Reservado" => "badge-ev-reservado",
        "Confirmado" => "badge-ev-confirmado",
        "Entregado" => "badge-ev-entregado",
        "Devuelto" => "badge-ev-devuelto",
        "Cancelado" => "badge-ev-cancelado",
        _ => "bg-secondary"
    };
}
