@model EVENTIA.Dtos.LoginDto
@{ ViewData["Title"] = "Iniciar Sesión"; }

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-4">Iniciar Sesión</h3>

                @if (TempData["Mensaje"] != null)
                {
                    <div class="alert alert-success">@TempData["Mensaje"]</div>
                }

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label">Correo</label>
                        <input asp-for="Correo" class="form-control" type="email" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Contrasena" class="form-label">Contraseña</label>
                        <input asp-for="Contrasena" class="form-control" type="password" />
                        <span asp-validation-for="Contrasena" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-dark w-100">Iniciar Sesión</button>
                </form>

                <hr />
                <p class="text-center">¿No tienes cuenta? <a asp-action="Registro">Regístrate aquí</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
