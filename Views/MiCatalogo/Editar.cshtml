@model EVENTIA.Dtos.ArticuloDto
@{ ViewData["Title"] = "Editar Artículo"; }

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow">
            <div class="card-body p-4">
                <h3 class="card-title mb-4">Editar Artículo</h3>

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <form asp-action="Editar" method="post">
                    <input type="hidden" asp-for="ArticuloId" />
                    <input type="hidden" asp-for="ProveedorId" />

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">Nombre</label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Precio" class="form-label">Precio por día (S/)</label>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0.01" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="CantidadTotal" class="form-label">Cantidad total</label>
                            <input asp-for="CantidadTotal" class="form-control" type="number" min="1" />
                            <span asp-validation-for="CantidadTotal" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CategoriaId" class="form-label">Categoría</label>
                        <select asp-for="CategoriaId" asp-items="@(new SelectList(ViewBag.Categorias, "CategoriaId", "Nombre"))" class="form-select">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ImagenUrl" class="form-label">URL de imagen</label>
                        <input asp-for="ImagenUrl" class="form-control" type="url" />
                        <span asp-validation-for="ImagenUrl" class="text-danger"></span>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="Activo" class="form-check-input" />
                        <label asp-for="Activo" class="form-check-label">Activo</label>
                    </div>
                    <button type="submit" class="btn btn-dark">Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
