@model EVENTIA.ViewModels.CarritoViewModel
@{ ViewData["Title"] = "Seleccionar Fecha"; }

<h2>Seleccionar Fecha del Evento</h2>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow">
            <div class="card-body">
                <p class="text-muted">Proveedor: <strong>@Model.ProveedorNombre</strong></p>
                <p class="text-muted">Artículos: @Model.Items.Count | Total: <strong>S/ @Model.MontoTotal.ToString("F2")</strong></p>

                <hr />

                <form asp-action="Confirmar" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Fecha del evento</label>
                        <input type="date" name="fechaEvento" class="form-control form-control-lg" required
                               min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
                        <small class="text-muted">Selecciona la fecha en que necesitas el equipamiento.</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg">Confirmar Pedido</button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Volver al Carrito</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
